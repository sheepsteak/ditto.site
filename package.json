{
  "name": "@cloner/mcp-stdio",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained ephemeral STDIO MCP website compiler.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ditto-mcp-stdio": "./bin/ditto-mcp.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "bin",
    "src",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "start": "node --experimental-strip-types bin/ditto-mcp.ts",
    "install-browser": "playwright install chromium",
    "test": "npm run test:unit && npm run test:compiler && npm run test:integration",
    "test:unit": "node --experimental-strip-types --test test/*.unit.test.ts",
    "test:compiler": "node --experimental-strip-types --test test/compiler/*.test.ts",
    "test:integration": "node --experimental-strip-types --test test/*.integration.test.ts",
    "test:pack": "npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "1.56.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "@typescript/native": "npm:typescript@^7.0.2",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.6"
  }
}
