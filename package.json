{
  "name": "@cloner/mcp-stdio",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained ephemeral STDIO MCP website compiler.",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "ditto-mcp-stdio": "./dist/stdio.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "clean": "tsx scripts/clean.ts",
    "build": "npm run clean && tsc -p tsconfig.build.json && tsx scripts/copy-assets.ts",
    "dev": "tsx src/stdio.ts",
    "start": "node dist/stdio.js",
    "install-browser": "playwright install chromium",
    "test": "npm run test:unit && npm run test:compiler && npm run test:integration && npm run test:dist && npm run test:packed",
    "test:unit": "node --import tsx --test test/*.unit.test.ts",
    "test:compiler": "node --import tsx --test test/compiler/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.test.ts",
    "test:dist": "npm run build && node --import tsx --test test/distRuntime.test.ts",
    "test:packed": "tsx scripts/test-packed.ts",
    "test:pack": "npm pack --dry-run",
    "prepack": "npm run build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "1.56.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
