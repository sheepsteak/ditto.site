{
  "name": "@cloner/mcp-stdio",
  "version": "0.1.0",
  "private": true,
  "description": "Self-contained ephemeral STDIO MCP website compiler.",
  "license": "MIT",
  "type": "module",
  "bin": { "ditto-mcp-stdio": "./bin/ditto-mcp.mjs" },
  "exports": { ".": "./src/index.ts" },
  "files": ["bin", "compiler/data", "compiler/src", "src", "LICENSE", "README.md"],
  "scripts": {
    "start": "node bin/ditto-mcp.mjs",
    "install-browser": "playwright install chromium",
    "test": "npm run test:unit && npm run test:compiler && npm run test:integration",
    "test:unit": "node --import tsx --test test/*.unit.test.ts",
    "test:compiler": "node --import tsx --test compiler/test/*.test.ts",
    "test:integration": "node --import tsx --test test/*.integration.test.ts",
    "test:pack": "npm pack --dry-run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "playwright": "1.56.1",
    "tsx": "4.22.4",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "22.10.5",
    "@types/pixelmatch": "5.2.6",
    "@types/pngjs": "6.0.5",
    "pixelmatch": "5.3.0",
    "pngjs": "7.0.0",
    "typescript": "5.7.3"
  },
  "engines": { "node": ">=20" }
}
